# ==============================================================================
# SIGETRAP - Configuración de Variables de Entorno (.env.example)
# ==============================================================================

# Entorno de Ejecución
NODE_ENV="development"
PORT=3000

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Supabase / Local)
# ------------------------------------------------------------------------------
# Conexión con pooling (PgBouncer) para Next.js / Serverless Handlers
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexión directa (para Prisma Migrations / CLI)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Seguridad y Autenticación (JWT / Cookies RBAC)
# ------------------------------------------------------------------------------
JWT_SECRET="super-secret-key-change-in-production-sigetrap-2026"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="sigetrap_session_token"

# ------------------------------------------------------------------------------
# 3. Almacenamiento de Archivos (Supabase Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_STORAGE_BUCKET_DOCS="sigetrap-expedientes"
